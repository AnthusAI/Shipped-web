{
  "siteId": "shipped",
  "stackName": "amplify-app-shell-shipped-cms",
  "repository": "https://github.com/AnthusAI/Shipped-web",
  "brand": "shipped",
  "frontend": "markus-static",
  "aws": { "profile": "papyrus-production", "accountId": "712236451410", "region": "us-east-1" },
  "papyrusVersion": "5.13.0",
  "cms": {
    "staging": false,
    "cognitoDomainPrefix": "papyrus-shipped-cms",
    "applyCognitoDomainPrefix": true,
    "buildComputeType": "STANDARD_8GB",
    "environment": {
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "false",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/,https://shipped.anth.us/"
    }
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "Shipped-web",
    "branches": [
      "main"
    ],
    "ownerId": 152415604,
    "repoId": 1428297675
  }
}
